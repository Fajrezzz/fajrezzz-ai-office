# ==============================================================
# FAJREZZZ AI OFFICE — SERVER-SIDE ENVIRONMENT VARIABLES
# ==============================================================
# Simpan API key HANYA di Environment Variables Vercel (Production + Preview
# + Development) atau di file lokal `.env.local` (sudah di-ignore git).
# JANGAN pernah memakai prefix NEXT_PUBLIC_ untuk key, dan JANGAN commit key asli.
#
# TUTORIAL LENGKAP (5 langkah + troubleshooting):
#   docs/API-KEY-ROUTER.md
#
# Verifikasi setelah mengisi & redeploy:
#   GET /api/ai/status            -> "primaryTriad": { gemini, groq, openrouter }
#   Panel "AI Router" di dashboard -> tombol "Tes Live Provider"
#
# Urutan fallback otomatis Central AI Router:
#   1) GROQ_API_KEY       -> Groq Free Tier (30 RPM, 1K-14.4K RPD, tanpa kartu kredit)
#   2) GEMINI_API_KEY     -> Google AI Studio Gemini Flash Free Tier (tanpa kartu kredit)
#   3) OPENROUTER_API_KEY -> OpenRouter :free models (20 RPM, 50 RPD, tanpa kartu kredit)
#   4) MISTRAL_API_KEY    -> Mistral Free Mode (opsional cadangan ke-4)
#   5) (tanpa key)        -> Pollinations keyless fallback Rp 0
# Minimal isi SALAH SATU key untuk mengaktifkan provider privat.

# --- Provider AI (isi minimal satu) -----------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/keys  (hanya model :free yang dipakai secara default)
OPENROUTER_API_KEY=
# https://console.mistral.ai/api-keys  (opsional)
MISTRAL_API_KEY=

# --- Opsional: memori agent jangka panjang (Hindsight) ----------------------
HINDSIGHT_API_KEY=
HINDSIGHT_API_URL=
HINDSIGHT_BANK_ID=

# --- Opsional: Supabase (simpan state ke database cloud) --------------------
# Mode data: "simulation" (localStorage) atau "supabase"
NEXT_PUBLIC_OFFICE_DATA_MODE=simulation
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, JANGAN pernah diberi prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Legacy / custom provider gateway (dibaca src/lib/config/env.ts) --------
# Dipakai hanya bila Anda memakai gateway OpenAI-compatible sendiri.
AI_PROVIDER_NAME=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_DEFAULT_MODEL=
