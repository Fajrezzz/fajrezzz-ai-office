# ==============================================================================
# FAJREZZZ AI OFFICE - Environment Variables Template
# ==============================================================================
# Salin file ini menjadi `.env.local` untuk konfigurasi lokal di tahap integrasi
# selanjutnya. Tahap 1 berjalan penuh dalam mode simulasi lokal (tanpa API key).
#
# ATURAN KEAMANAN:
# - JANGAN PERNAH memberi prefix `NEXT_PUBLIC_` pada secret API key!
# - Semua pemanggilan AI API dan operasi sensitif Supabase WAJIB dilakukan
#   di server (Next.js Route Handlers / Server Actions).
# ==============================================================================

# Mode aplikasi saat ini: "simulation" | "supabase"
NEXT_PUBLIC_OFFICE_DATA_MODE=simulation

# --- Future Supabase Integration (Public Client Config) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Future Supabase Server-Only Secret (NEVER expose to browser) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Future AI Provider Integration (SERVER-ONLY, NEVER expose to browser) ---
AI_PROVIDER_NAME=none
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_DEFAULT_MODEL=
