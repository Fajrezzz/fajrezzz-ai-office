Dialogue: 0,0:00:00.08,0:00:01.89,Default,,0,0,0,,Pengangguran turun. Tapi gaji
Dialogue: 0,0:00:01.89,0:00:03.21,Default,,0,0,0,,temanmu tidak naik. Dua
Dialogue: 0,0:00:03.21,0:00:04.36,Default,,0,0,0,,angka ini keluar di
Dialogue: 0,0:00:04.36,0:00:05.67,Default,,0,0,0,,hari yang sama. Jumlah
Dialogue: 0,0:00:05.67,0:00:06.86,Default,,0,0,0,,orang bekerja naik dan
Dialogue: 0,0:00:06.86,0:00:08.95,Default,,0,0,0,,pengangguran turun, namun rata-rata
Dialogue: 0,0:00:08.95,0:00:10.43,Default,,0,0,0,,upah buruh masih sekitar
Dialogue: 0,0:00:10.43,0:00:11.46,Default,,0,0,0,,{\rAccent}3,42{\rDefault} juta rupiah per
Dialogue: 0,0:00:11.46,0:00:13.48,Default,,0,0,0,,bulan. Tingkat Pengangguran Terbuka
Dialogue: 0,0:00:13.48,0:00:14.97,Default,,0,0,0,,Agustus {\rAccent}2026{\rDefault} sebesar {\rAccent}4,75{\rDefault}
Dialogue: 0,0:00:14.97,0:00:16.26,Default,,0,0,0,,persen, turun {\rAccent}0,09{\rDefault} persen
Dialogue: 0,0:00:16.26,0:00:17.92,Default,,0,0,0,,poin dibanding Agustus {\rAccent}2025.{\rDefault}
Dialogue: 0,0:00:17.92,0:00:19.84,Default,,0,0,0,,Contohnya, penduduk bekerja pada
Dialogue: 0,0:00:19.84,0:00:21.51,Default,,0,0,0,,Agustus {\rAccent}2026{\rDefault} sebanyak {\rAccent}147,99{\rDefault}
Dialogue: 0,0:00:21.51,0:00:22.76,Default,,0,0,0,,juta orang, naik {\rAccent}1,443{\rDefault}
Dialogue: 0,0:00:22.76,0:00:24.22,Default,,0,0,0,,juta orang dari Agustus
Dialogue: 0,0:00:24.22,0:00:25.62,Default,,0,0,0,,{\rAccent}2025.{\rDefault} Yang sering luput,
Dialogue: 0,0:00:25.62,0:00:27.25,Default,,0,0,0,,rata-rata upah buruh pada
Dialogue: 0,0:00:27.25,0:00:28.75,Default,,0,0,0,,Agustus {\rAccent}2026{\rDefault} sebesar {\rAccent}3,42{\rDefault}
Dialogue: 0,0:00:28.75,0:00:30.44,Default,,0,0,0,,juta rupiah. Jadi intinya,
Dialogue: 0,0:00:30.44,0:00:31.80,Default,,0,0,0,,jumlah orang bekerja naik
Dialogue: 0,0:00:31.80,0:00:33.41,Default,,0,0,0,,dan pengangguran turun, namun
Dialogue: 0,0:00:33.41,0:00:35.05,Default,,0,0,0,,rata-rata upah buruh masih
Dialogue: 0,0:00:35.05,0:00:36.75,Default,,0,0,0,,sekitar {\rAccent}3,42.{\rDefault} Sumber lengkapnya
Dialogue: 0,0:00:36.75,0:00:38.22,Default,,0,0,0,,ada di deskripsi. Simpan
Dialogue: 0,0:00:38.22,0:00:39.85,Default,,0,0,0,,video ini kalau menurutmu
Dialogue: 0,0:00:39.85,0:00:40.48,Default,,0,0,0,,berguna.