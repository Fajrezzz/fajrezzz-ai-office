Dialogue: 0,0:00:00.06,0:00:03.65,Default,,0,0,0,,Cooler HP itu cuma kipas plus lempeng logam.
Dialogue: 0,0:00:03.65,0:00:06.42,Default,,0,0,0,,Tapi kadang keluar {\rAccent}air,{\rDefault} bahkan {\rAccent}es.{\rDefault}
Dialogue: 0,0:00:06.42,0:00:08.86,Default,,0,0,0,,{\rAccent}Airnya{\rDefault} datang dari mana, coba?
Dialogue: 0,0:00:09.53,0:00:11.77,Default,,0,0,0,,Jawabannya bukan di kipasnya.
Dialogue: 0,0:00:11.77,0:00:14.79,Default,,0,0,0,,Di dalam ada chip {\rAccent}Peltier:{\rDefault} arus listrik
Dialogue: 0,0:00:14.79,0:00:17.11,Default,,0,0,0,,lewat dua jenis semikonduktor,
Dialogue: 0,0:00:17.11,0:00:20.75,Default,,0,0,0,,lalu panas dipompa dari satu sisi ke sisi lain.
Dialogue: 0,0:00:20.75,0:00:23.61,Default,,0,0,0,,Sisi yang menempel di HP jadi dingin,
Dialogue: 0,0:00:23.61,0:00:26.39,Default,,0,0,0,,sisi belakangnya justru makin panas.
Dialogue: 0,0:00:27.06,0:00:30.34,Default,,0,0,0,,Dan udara di sekitar kamu itu tidak kosong.
Dialogue: 0,0:00:30.34,0:00:32.70,Default,,0,0,0,,Selalu ada uap {\rAccent}air{\rDefault} di dalamnya,
Dialogue: 0,0:00:32.70,0:00:34.60,Default,,0,0,0,,walaupun tidak kelihatan.
Dialogue: 0,0:00:34.60,0:00:37.42,Default,,0,0,0,,Uap ini berubah jadi titik {\rAccent}air{\rDefault} begitu
Dialogue: 0,0:00:37.42,0:00:40.09,Default,,0,0,0,,ketemu permukaan yang cukup dingin.
Dialogue: 0,0:00:40.73,0:00:43.61,Default,,0,0,0,,Batas dinginnya namanya titik {\rAccent}embun.{\rDefault}
Dialogue: 0,0:00:43.61,0:00:48.88,Default,,0,0,0,,Contoh gampangnya: ruangan {\rAccent}25{\rDefault} derajat dengan kelembapan {\rAccent}60{\rDefault} persen,
Dialogue: 0,0:00:48.88,0:00:51.60,Default,,0,0,0,,titik {\rAccent}embunnya{\rDefault} sekitar {\rAccent}17{\rDefault} derajat.
Dialogue: 0,0:00:51.60,0:00:54.80,Default,,0,0,0,,Begitu lempeng cooler turun di bawah {\rAccent}17,{\rDefault}
Dialogue: 0,0:00:54.80,0:00:56.32,Default,,0,0,0,,{\rAccent}air{\rDefault} mulai menempel.
Dialogue: 0,0:00:56.32,0:00:58.24,Default,,0,0,0,,Belum perlu {\rAccent}nol{\rDefault} derajat.
Dialogue: 0,0:00:58.89,0:01:01.73,Default,,0,0,0,,Sama seperti gelas {\rAccent}es{\rDefault} teh yang {\rAccent}berembun.{\rDefault}
Dialogue: 0,0:01:01.73,0:01:04.29,Default,,0,0,0,,{\rAccent}Airnya{\rDefault} bukan bocor dari dalam gelas,
Dialogue: 0,0:01:04.29,0:01:07.84,Default,,0,0,0,,tapi dari udara yang menempel di permukaan dingin.
Dialogue: 0,0:01:08.49,0:01:12.45,Default,,0,0,0,,Kalau permukaannya bisa tembus di bawah {\rAccent}nol{\rDefault} derajat,
Dialogue: 0,0:01:12.45,0:01:15.18,Default,,0,0,0,,titik {\rAccent}air{\rDefault} itu membeku jadi bunga {\rAccent}es.{\rDefault}
Dialogue: 0,0:01:15.18,0:01:16.02,Default,,0,0,0,,Tapi di HP,
Dialogue: 0,0:01:16.02,0:01:19.44,Default,,0,0,0,,lempeng biasanya cuma sampai belasan derajat.
Dialogue: 0,0:01:19.44,0:01:22.94,Default,,0,0,0,,Jadi yang kamu lihat kebanyakan {\rAccent}air,{\rDefault} bukan {\rAccent}es.{\rDefault}
Dialogue: 0,0:01:23.59,0:01:26.31,Default,,0,0,0,,Satu lagi yang sering salah dibaca.
Dialogue: 0,0:01:26.31,0:01:29.10,Default,,0,0,0,,Angka {\rAccent}30{\rDefault} {\rAccent}watt{\rDefault} di kemasan itu listrik
Dialogue: 0,0:01:29.10,0:01:30.26,Default,,0,0,0,,yang dia makan,
Dialogue: 0,0:01:30.26,0:01:32.20,Default,,0,0,0,,bukan panas yang dibuang.
Dialogue: 0,0:01:32.20,0:01:34.84,Default,,0,0,0,,Chip {\rAccent}Peltier{\rDefault} malah menambah panas,
Dialogue: 0,0:01:34.84,0:01:38.95,Default,,0,0,0,,makanya sisi belakang wajib punya heatsink dan kipas.
Dialogue: 0,0:01:39.59,0:01:42.94,Default,,0,0,0,,Efek sampingnya nyata: {\rAccent}air{\rDefault} bisa {\rAccent}merembes{\rDefault} ke
Dialogue: 0,0:01:42.94,0:01:45.04,Default,,0,0,0,,celah bodi dan area kamera.
Dialogue: 0,0:01:45.04,0:01:48.54,Default,,0,0,0,,Pabrikan sendiri mengakui {\rAccent}tetesan{\rDefault} itu normal,
Dialogue: 0,0:01:48.54,0:01:50.56,Default,,0,0,0,,tapi tetap harus kamu lap.
Dialogue: 0,0:01:51.19,0:01:54.81,Default,,0,0,0,,Cara amannya: pakai saat HP benar-benar panas,
Dialogue: 0,0:01:54.81,0:01:56.93,Default,,0,0,0,,jangan ditinggal semalaman,
Dialogue: 0,0:01:56.93,0:02:00.31,Default,,0,0,0,,dan lap bagian yang basah sebelum disimpan.
Dialogue: 0,0:02:00.96,0:02:04.28,Default,,0,0,0,,Jadi bukan cooler-nya yang mengeluarkan {\rAccent}air.{\rDefault}
Dialogue: 0,0:02:04.28,0:02:06.31,Default,,0,0,0,,{\rAccent}Air{\rDefault} itu sudah ada di udara,
Dialogue: 0,0:02:06.31,0:02:09.48,Default,,0,0,0,,cuma menempel di tempat yang lebih dingin.